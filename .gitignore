# File: .gitignore

# Virtual environment
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Generated output (evaluators will generate this themselves)
output/

# Environment variables (contains API keys!)
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test artifacts
.pytest_cache/
playwright-report/
test-results/